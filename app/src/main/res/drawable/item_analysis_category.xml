<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <View android:id="@+id/dot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_light_blue" android:layout_centerVertical="true"/>
    <TextView android:layout_toEndOf="@id/dot" android:layout_marginStart="8dp" android:text="Food" android:textColor="#2D3142" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:layout_alignParentEnd="true" android:text="35%" android:textStyle="bold" android:textColor="#1A1C24" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</RelativeLayout>