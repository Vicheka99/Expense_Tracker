<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Payment Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Name"
            android:textColor="#9DA3B4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etRecName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. Rent, Netflix"
            android:textColor="#1A1C24"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_form_input"
            android:layout_marginBottom="16dp"
            android:singleLine="true" />

        <!-- Amount -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount ($)"
            android:textColor="#9DA3B4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etRecAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="0.00"
            android:textColor="#1A1C24"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_form_input"
            android:layout_marginBottom="16dp"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <!-- Frequency -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frequency"
            android:textColor="#9DA3B4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spRecFreq"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_form_input"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="12dp" />

        <!-- Due Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Date"
            android:textColor="#9DA3B4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etRecDue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. 1st of Month"
            android:textColor="#1A1C24"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_form_input"
            android:layout_marginBottom="8dp"
            android:singleLine="true" />

    </LinearLayout>
</ScrollView>
