<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Category Icon Header -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTxDetailsIconBg"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#E3F2FD">

        <ImageView
            android:id="@+id/ivTxDetailsIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:src="@drawable/ic_shopping_bag"
            app:tint="#4A90E2" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Title Note -->
    <TextView
        android:id="@+id/tvTxDetailsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buy Pant"
        android:textColor="#2D3142"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Amount -->
    <TextView
        android:id="@+id/tvTxDetailsAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-$8.99"
        android:textColor="#F44336"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Details Box (Cards/Rows) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_details_box"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <!-- Row 1: Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:id="@+id/tvLabelType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Type"
                android:textColor="#9DA3B4"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvTxDetailsType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPENSE"
                android:textStyle="bold"
                android:textColor="#F44336"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EBF3FC"
            android:layout_marginBottom="12dp"/>

        <!-- Row 2: Category -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:id="@+id/tvLabelDetailsCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Category"
                android:textColor="#9DA3B4"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvTxDetailsCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop"
                android:textStyle="bold"
                android:textColor="#2D3142"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EBF3FC"
            android:layout_marginBottom="12dp"/>

        <!-- Row 3: Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <TextView
                android:id="@+id/tvLabelDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Date"
                android:textColor="#9DA3B4"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvTxDetailsDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-07-01"
                android:textStyle="bold"
                android:textColor="#2D3142"
                android:textSize="14sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Close Button (Primary Pill Button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTxDetailsClose"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#4A90E2"
            app:cornerRadius="26dp"
            android:layout_marginBottom="8dp" />

        <!-- Delete Button (Text Button Red) -->
        <TextView
            android:id="@+id/btnTxDetailsDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete Transaction"
            android:textColor="#F44336"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</LinearLayout>
