<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Goal Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goal Name"
            android:textColor="#9DA3B4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etGoalName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. New Laptop"
            android:textColor="#1A1C24"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_form_input"
            android:layout_marginBottom="16dp"
            android:singleLine="true" />

        <!-- Target Amount -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target Amount ($)"
            android:textColor="#9DA3B4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etGoalTarget"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="0.00"
            android:textColor="#1A1C24"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_form_input"
            android:layout_marginBottom="16dp"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <!-- Current Saved -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Saved ($)"
            android:textColor="#9DA3B4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etGoalCurrent"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="0.00"
            android:textColor="#1A1C24"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_form_input"
            android:layout_marginBottom="8dp"
            android:inputType="numberDecimal"
            android:singleLine="true" />

    </LinearLayout>
</ScrollView>
